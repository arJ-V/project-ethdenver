# 0G Network (Galileo Testnet)
A0G_PRIVATE_KEY=your_wallet_private_key_hex
A0G_RPC_URL=https://evmrpc-testnet.0g.ai
A0G_PROVIDER_ADDRESS=0xa48f01287233509FD694a22Bf840225062E67836
A0G_MODEL=qwen-2.5-7b-instruct

# OpenAI fallback (used if 0G is unavailable or fails)
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini  # Model to use when USE_0G=false (gpt-4o-mini, gpt-4, gpt-3.5-turbo, etc.)

# Control whether to prefer 0G (true) or always use OpenAI (false)
# Set USE_0G=false to test with OpenAI only (e.g. while 0G account is being fixed)
USE_0G=true

# Demo wallets for TRADE mode (user doesn't have to say writer/buyer; agent uses these by default)
DEMO_WRITER_ADDRESS=0x1234567890123456789012345678901234567890
DEMO_BUYER_ADDRESS=0xabcdefabcdefabcdefabcdefabcdefabcdefabcd

# QuickNode/SolarTick telemetry (optional). When set, agent gets solar yield/battery context in ASK and TRADE.
# Run solartick backend (e.g. cd solartick && docker compose up) and point to its API.
SOLARTICK_API_BASE_URL=http://localhost:8000
SOLARTICK_SITE_ID=1

# Trading platform API (order submission). Run packages/trading-api and set to its URL.
# Set HEDERA_MOCK=true to skip real submission (mock response only).
HEDERA_API_BASE_URL=http://localhost:3001
HEDERA_MOCK=true

# App
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
