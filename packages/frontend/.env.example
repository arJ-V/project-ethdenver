# SolarTick backend (Postgres / RWA API): pricing graph, asset list, immutable feed
# When empty, frontend uses same origin (e.g. Next.js rewrites or same host).
NEXT_PUBLIC_SOLARTICK_API_URL=http://localhost:8000

# AI Copilot (Ask / Trade): chat and intent submission. Required for the AI Copilot panel.
# Run copilot: cd packages/ai-copilot && uvicorn main:app --port 8003
# Use a different port if SolarTick backend is on 8000 (e.g. copilot on 8003).
NEXT_PUBLIC_COPILOT_API_URL=http://localhost:8003
