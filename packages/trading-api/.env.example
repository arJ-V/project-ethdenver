# Hedera testnet RPC (hashio or your node)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# ADI testnet RPC for ADI event indexing
ADI_RPC_URL=https://rpc.ab.testnet.adifoundation.ai/

# Hedera mirror base URL for timeline indexing
HEDERA_MIRROR_BASE_URL=https://testnet.mirrornode.hedera.com

# Writer wallet private key (hex, no 0x prefix or with 0x both ok)
# This account must hold ySOLAR and have approved the options desk.
WRITER_PRIVATE_KEY=your_private_key_hex

# Options desk contract address (optional if docs/deployed-addresses.json exists)
# HEDERA_OPTIONS_DESK_ADDRESS=0x...

# ADI vault contract address (optional if docs/deployed-addresses.json exists)
# ADI_VAULT_ADDRESS=0x...

# Optional API key placeholder for write/admin endpoints
# TRADING_API_KEY=demo-shared-secret

# Read-model storage file
READ_MODEL_FILE=./data/read-model.json

# Indexer polling interval in milliseconds
INDEXER_POLL_MS=7000

# Server
PORT=3001
