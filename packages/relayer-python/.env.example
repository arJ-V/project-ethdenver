# =============================================================================
# Relayer env — copy to .env and fill required values.
# With docker compose, DATABASE_URL is set by compose; other vars from env_file.
# =============================================================================

# --- Required (relayer fails at startup if missing) ---
ADI_RPC_URL=https://rpc.ab.testnet.adifoundation.ai/
ADI_VAULT_ADDRESS=
ADI_START_BLOCK=latest
ADI_OPERATOR_PRIVATE_KEY=
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_RPC_URL=https://testnet.hashio.io/api
ORACLE_CONTRACT_ADDRESS=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solartick

HEDERA_YSOLAR_ADDRESS=
HEDERA_NETWORK=testnet

# Oracle: if unset, relayer uses HEDERA_OPERATOR_KEY for pushYieldIndex (must have ADMIN_ORACLE_ROLE)
ORACLE_PUSH_THRESHOLD_SECONDS=240

# Telemetry: oracle updates are driven by queue (webhook → backend → oracle_pending_updates → relayer).
# mock = time-based index when no queue row (legacy); quicknode = HTTP GET yieldIndex (legacy).
TELEMETRY_SOURCE=mock
TELEMETRY_TIMEOUT_SECONDS=6
LOCAL_STATE_FILE=.relayer_state.json
