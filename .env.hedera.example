# Hedera testnet – use for contracts-hedera, trading-api, relayer.
# Copy to .env (root) and/or packages/relayer-python/.env and packages/trading-api/.env.
# Never commit .env.

HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_OPERATOR_KEY=0x_your_operator_private_key_hex
# Optional: same key as writer for trading-api
WRITER_PRIVATE_KEY=0x_same_or_writer_key

# Optional overrides (default: docs/deployed-addresses.json)
# HEDERA_YSOLAR_ADDRESS=0x...
# HEDERA_OPTIONS_DESK_ADDRESS=0x...
# HEDERA_ORACLE_ADDRESS=0x...

# ADI (if using relayer)
# ADI_RPC_URL=https://rpc.ab.testnet.adifoundation.ai/
# ADI_VAULT_ADDRESS=0x...
# ADI_OPERATOR_PRIVATE_KEY=0x...
