# Postgres
# Local (docker compose): use host "db" when backend runs in compose, or "localhost" when backend runs on host
# Remote: use your DB host and port (Postgres is TCP on 5432, not HTTP)
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/solartick
# Example remote DB (replace user/password/db as needed):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@16.58.44.187:5432/solartick

# Monad Testnet + contract
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
PUBLISHER_PRIVATE_KEY=
TELEMETRY_CONTRACT_ADDRESS=
BACKEND_URL=http://backend:8000

# ADI vault orchestration (Create RWA bootstrap)
ADI_RPC_URL=https://rpc.ab.testnet.adifoundation.ai/
ADI_VAULT_ADDRESS=
ADI_OPERATOR_PRIVATE_KEY=
RWA_DEFAULT_BENEFICIARY=

# QuickNode Streams webhook (set after creating Stream; backend verifies HMAC with this)
QN_STREAMS_WEBHOOK_SECRET=

# Publisher behavior
SITE_ID=1
PUBLISH_INTERVAL_MS=5000

# Backend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo reset: when set, POST /api/reset?secret=<this> truncates telemetry_points
DEMO_RESET_SECRET=
